{
  "metadata": [
    {
      "src": [
        {
          "src": "..",
          "files": ["StatisticalRobot-Lib/StatisticalRobot-Lib.csproj"]
        }
      ],
      "dest": "api",
      "properties": {
        "TargetFramework": "net8.0",
        "GeneratePackageOnBuild": "false"
      }
    }
  ],
  "build": {
    "content": [
      { "files": ["index.md", "toc.yml", "guide/**.md", "guide/toc.yml", "api/**.yml"] }
    ],
    "resource": [
      { "files": ["images/**.svg", "images/**.png"] }
    ],
    "output": "_site",
    "template": ["default", "modern", "templates/custom"],
    "globalMetadata": {
      "_appTitle": "Avans Robot Library",
      "_appName": "Avans Robot Library",
      "_appLogoPath": "images/avans.svg",
      "_appFaviconPath": "images/avans.svg",
      "_appFooter": "Avans StatisticalRobot library documentation",
      "_enableSearch": true,
      "_lang": "en"
    }
  }
}
